# Port serial. Isi "mock" kalau mau jalan tanpa hardware fisik untuk ujicoba.
# Contoh nilai asli: /dev/ttyUSB0 (Linux) atau COM3 (Windows)
SERIAL_PORT=mock
SERIAL_BAUD_RATE=115200
SERIAL_RECONNECT_DELAY=3000

# REST API tujuan
API_URL=http://localhost:10000/api/sensor-data
API_TIMEOUT=5000
API_MAX_RETRY=3
API_RETRY_DELAY=1000